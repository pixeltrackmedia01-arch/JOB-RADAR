# Database (production: Supabase gateway; local/tests: direct Postgres)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=sb_publishable_...
DB_GATEWAY_SECRET=            # >= 32 chars; its SHA-256 is stored in jobradar.app_secrets
# DATABASE_URL=postgresql://postgres@localhost:5432/jobradar
APP_URL=                       # optional; defaults to the Vercel production URL
APP_SECRET=                    # >= 32 chars; signs management links + admin sessions
ADMIN_PASSWORD=                # >= 12 chars
CRON_SECRET=                   # >= 32 chars; bearer token for /api/cron/tick
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Email (optional until you want to send): Resend or Postmark
RESEND_API_KEY=
POSTMARK_SERVER_TOKEN=
EMAIL_FROM=JobRadar <alerts@yourdomain.com>
# Optional sources
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
